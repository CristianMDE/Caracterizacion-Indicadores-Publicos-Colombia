Barras HTML = 
-- ===== Colores y tamaños =====
VAR cQ1 = "#FCB714"
VAR cQ2 = "#70B0E0"
VAR cQ3 = "#0EB194"
VAR cQ4 = "#2878BD"
VAR cDep = "#2878BD"
VAR cMun = "#0EB194"
VAR cBog = "#FCB714"
VAR cCol = "#F15628"
VAR cTexto = "#131312"
VAR cFondo = "#FFFFFF"
VAR cClaro = "#E5E0DA"
VAR cAcento = "#2878BD"
VAR anchoSvg = 650
VAR altoVentana = 550
VAR altoFilaMin = 22
VAR yIni = 8
VAR xBarra = 212
VAR largoMax = 460

-- ===== Enlace al perfil =====
VAR urlPerfil = "https://x.com/CristianMDE"
VAR textoPerfil = "Elaborado por Cristian Ortega - @CristianMDE"
VAR firma =
    "<div style='font-size:11px;text-align:right;margin-top:4px'><a href='" & urlPerfil
        & "' target='_blank' rel='noopener' style='color:" & cAcento & ";text-decoration:none;font-weight:600'>"
        & textoPerfil & "</a></div>"

-- ===== Filtros obligatorios (indicador por llave de homologación y año) =====
VAR okInd = ISFILTERED ( 'Homologación_indicadores_fuente_homologada'[Llave] ) && HASONEVALUE ( 'Homologación_indicadores_fuente_homologada'[Llave] )
VAR okAno = ISFILTERED ( TerriData[Año] ) && HASONEVALUE ( TerriData[Año] )
VAR todoOk = okInd && okAno
VAR faltan0 =
    IF ( NOT okInd, "Indicador, " )
        & IF ( NOT okAno, "Año, " )
VAR faltan = IF ( LEN ( faltan0 ) > 2, LEFT ( faltan0, LEN ( faltan0 ) - 2 ) )

-- ===== Textos del título =====
VAR tDim = SELECTEDVALUE ( 'Homologación_indicadores_fuente_homologada'[Dimensión] )
VAR tSub = SELECTEDVALUE ( 'Homologación_indicadores_fuente_homologada'[Subcategoría] )
VAR tInd = SELECTEDVALUE ( 'Homologación_indicadores_fuente_homologada'[Indicador] )
VAR tFue = SELECTEDVALUE ( TerriData[Fuente] )
VAR tAno = SELECTEDVALUE ( TerriData[Año] )
VAR tUni = SELECTEDVALUE ( TerriData[Unidad de Medida] )

-- ===== Valor por entidad y su nivel =====
VAR datos0 =
    ADDCOLUMNS (
        VALUES ( TerriData[Código Entidad] ),
        "@c", IFERROR ( VALUE ( TerriData[Código Entidad] ), BLANK () ),
        "@n", CALCULATE ( MAX ( TerriData[Entidad] ) ),
        "@v", CALCULATE ( AVERAGE ( TerriData[Dato Numérico] ) )
    )
VAR datos1 =
    ADDCOLUMNS (
        FILTER ( datos0, NOT ISBLANK ( [@v] ) && NOT ISBLANK ( [@c] ) ),
        "@niv",
            SWITCH (
                TRUE (),
                [@c] = 1001, "N",
                [@c] = 11001, "B",
                MOD ( [@c], 1000 ) = 0, "D",
                "M"
            )
    )

-- ===== Qué se dibuja: todas las entidades del contexto, menos Colombia =====
VAR S0 = FILTER ( datos1, [@niv] <> "N" )
VAR S =
    ADDCOLUMNS (
        S0,
        "@r",
            VAR v = [@v]
            VAR c = [@c]
            RETURN
                COUNTROWS ( FILTER ( S0, [@v] > v || ( [@v] = v && [@c] < c ) ) ) + 1
    )
VAR n = COUNTROWS ( S )
VAR nMun = COUNTROWS ( FILTER ( S, [@niv] = "M" ) )
VAR nDep = n - nMun
-- Cuartiles solo si todo lo mostrado es del mismo nivel y hay suficientes entidades
VAR porCuartil = n >= 8 && ( nMun = 0 || nDep = 0 )

-- ===== Valor de Colombia (fila fija al final) =====
VAR vCol =
    CALCULATE (
        AVERAGE ( TerriData[Dato Numérico] ),
        REMOVEFILTERS (
            TerriData[Entidad],
            TerriData[Código Entidad],
            TerriData[Departamento],
            TerriData[Código Departamento],
            TerriData[Nivel]
        ),
        TerriData[Código Entidad] = "01001"
    )
VAR hayCol = NOT ISBLANK ( vCol )

-- ===== Escala (solo con las entidades mostradas), filas y letra =====
VAR vMax = MAXX ( S, [@v] )
VAR vMin = MINX ( S, [@v] )
VAR escala = IF ( vMax > 0, vMax, 1 )
VAR fmtBar = IF ( MAX ( vMax, vCol ) >= 1000, "#,0", "#,0.0" )
VAR filas = n + IF ( hayCol, 1, 0 )
VAR altoFila = MAX ( altoFilaMin, MIN ( INT ( ( altoVentana - yIni - 18 ) / filas ), 46 ) )
VAR grosor = MAX ( 6, MIN ( INT ( altoFila * 0.68 ), 30 ) )
VAR letra = SWITCH ( TRUE (), altoFila >= 34, 16, altoFila >= 24, 15, 13 )
VAR bajaTexto = INT ( letra * 0.35 )
VAR maxLetras = IF ( letra >= 15, 23, 27 )
VAR yFinEntidades = yIni + altoFila * n
VAR altoSvg = yFinEntidades + IF ( hayCol, altoFila + 10, 0 ) + 8

-- ===== Cuartiles =====
VAR q1 = PERCENTILEX.INC ( S, [@v], 0.25 )
VAR q2 = PERCENTILEX.INC ( S, [@v], 0.50 )
VAR q3 = PERCENTILEX.INC ( S, [@v], 0.75 )

-- ===== Barras (una fila por entidad) =====
VAR barras =
    CONCATENATEX (
        S,
        VAR v = [@v]
        VAR r = [@r]
        VAR yc = yIni + ( r - 1 ) * altoFila + INT ( altoFila / 2 )
        VAR largo = MAX ( 0, ROUND ( v / escala * largoMax, 0 ) )
        VAR nom = IF ( LEN ( [@n] ) > maxLetras, LEFT ( [@n], maxLetras - 1 ) & "…", [@n] )
        VAR col =
            IF (
                porCuartil,
                SWITCH ( TRUE (), v <= q1, cQ1, v <= q2, cQ2, v <= q3, cQ3, cQ4 ),
                SWITCH ( [@niv], "D", cDep, "B", cBog, cMun )
            )
        RETURN
            "<text x='" & ( xBarra - 8 ) & "' y='" & ( yc + bajaTexto ) & "' text-anchor='end' font-size='" & letra
                & "' fill='" & cTexto & "'>" & nom & "</text>"
                & "<rect x='" & xBarra & "' y='" & ( yc - INT ( grosor / 2 ) ) & "' width='" & largo
                & "' height='" & grosor & "' fill='" & col & "'><title>" & [@n] & ": " & FORMAT ( v, "#,0.00" )
                & " · puesto " & r & " de " & n & "</title></rect>"
                & "<text x='" & ( xBarra + largo + 6 ) & "' y='" & ( yc + bajaTexto ) & "' font-size='" & letra
                & "' font-weight='700' fill='" & cTexto & "'>" & FORMAT ( v, fmtBar ) & "</text>",
        ""
    )

-- ===== Fila de Colombia (siempre al final, separada por una línea) =====
VAR fueraEscala = vCol > escala
VAR largoCol = MAX ( 0, ROUND ( MIN ( vCol / escala, 1 ) * largoMax, 0 ) )
VAR ycCol = yFinEntidades + 10 + INT ( altoFila / 2 )
VAR filaCol =
    IF (
        hayCol,
        "<line x1='10' x2='" & ( anchoSvg - 10 ) & "' y1='" & ( yFinEntidades + 5 ) & "' y2='"
            & ( yFinEntidades + 5 ) & "' stroke='" & cClaro & "' stroke-width='2'/>"
            & "<text x='" & ( xBarra - 8 ) & "' y='" & ( ycCol + bajaTexto ) & "' text-anchor='end' font-size='"
            & letra & "' font-weight='700' fill='" & cCol & "'>Colombia</text>"
            & "<rect x='" & xBarra & "' y='" & ( ycCol - INT ( grosor / 2 ) ) & "' width='" & largoCol
            & "' height='" & grosor & "' fill='" & cCol & "'><title>Colombia: " & FORMAT ( vCol, "#,0.00" )
            & "</title></rect>"
            & "<text x='" & ( xBarra + largoCol + 6 ) & "' y='" & ( ycCol + bajaTexto ) & "' font-size='" & letra
            & "' font-weight='700' fill='" & cCol & "'>" & FORMAT ( vCol, fmtBar )
            & IF ( fueraEscala, " »", "" ) & "</text>"
    )

VAR eje =
    "<line x1='" & xBarra & "' x2='" & xBarra & "' y1='" & ( yIni - 2 ) & "' y2='" & ( altoSvg - 6 )
        & "' stroke='" & cTexto & "' stroke-width='1'/>"

VAR svg =
    "<div style='max-height:" & altoVentana & "px;overflow-y:auto;overflow-x:hidden'>"
        & "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 " & anchoSvg & " " & altoSvg
        & "' preserveAspectRatio='xMinYMin meet' style='width:100%;height:" & altoSvg
        & "px;display:block;font-family:Segoe UI,Arial,sans-serif'>" & barras & filaCol & eje & "</svg></div>"

-- ===== Leyenda (debajo del subtítulo) =====
VAR chipIni = "<span style='display:inline-block;margin-right:14px;white-space:nowrap'><span style='display:inline-block;width:13px;height:13px;vertical-align:middle;margin-right:5px;background:"
VAR leyenda =
    "<div style='font-size:13px;margin-top:4px'>"
        & IF (
            porCuartil,
            chipIni & cQ1 & "'></span>Q1: hasta " & FORMAT ( q1, fmtBar ) & "</span>"
                & chipIni & cQ2 & "'></span>Q2: hasta " & FORMAT ( q2, fmtBar ) & "</span>"
                & chipIni & cQ3 & "'></span>Q3: hasta " & FORMAT ( q3, fmtBar ) & "</span>"
                & chipIni & cQ4 & "'></span>Q4: hasta " & FORMAT ( vMax, fmtBar ) & "</span>",
            chipIni & cDep & "'></span>Departamento</span>"
                & chipIni & cMun & "'></span>Municipio</span>"
                & chipIni & cBog & "'></span>Bogotá</span>"
        )
        & IF ( hayCol, chipIni & cCol & "'></span>Colombia: " & FORMAT ( vCol, fmtBar ) & "</span>" )
        & "</div>"

-- ===== Título y resumen =====
VAR titulo =
    "<div style='border-left:6px solid " & cAcento & ";padding:0 0 0 10px;margin-bottom:6px'>"
        & "<div style='font-size:20px;font-weight:700;line-height:1.2'>" & tInd & " · " & tAno & "</div>"
        & "<div style='font-size:13px;margin-top:2px'>"
        & IF ( NOT ISBLANK ( tDim ) && NOT ISBLANK ( tSub ), tDim & " › " & tSub & " · " ) & "Fuente: " & tFue
        & IF ( NOT ISBLANK ( tUni ), " · Unidad: " & tUni ) & "</div>" & leyenda & "</div>"

VAR nomMax = MAXX ( FILTER ( S, [@r] = 1 ), [@n] )
VAR Spos = FILTER ( S, [@v] > 0 )
VAR nCero = n - COUNTROWS ( Spos )
VAR vMinPos = IF ( COUNTROWS ( Spos ) > 0, MINX ( Spos, [@v] ), vMin )
VAR nomMin =
    IF (
        COUNTROWS ( Spos ) > 0,
        MAXX ( TOPN ( 1, Spos, [@v], ASC, [@c], ASC ), [@n] ),
        MAXX ( FILTER ( S, [@r] = n ), [@n] )
    )
VAR resumen =
    "<div style='font-size:13px;text-align:center;margin-top:4px'>" & n & " entidades · Más alto: <b>" & nomMax
        & "</b> (" & FORMAT ( vMax, fmtBar ) & ") · Más bajo: <b>" & nomMin & "</b> (" & FORMAT ( vMinPos, fmtBar )
        & ") · Brecha: <b>" & FORMAT ( vMax - vMinPos, fmtBar ) & "</b>"
        & IF ( nCero > 0, " · " & nCero & " en cero" ) & "</div>"

VAR abre =
    "<div style='font-family:Segoe UI,Arial,sans-serif;color:" & cTexto & ";background:" & cFondo
        & ";width:100%;box-sizing:border-box;padding:4px 10px'>"

VAR aviso =
    abre & "<div style='height:600px;background:" & cClaro
        & ";text-align:center;padding:240px 40px 0 40px;box-sizing:border-box'>"
        & "<div style='font-size:22px;font-weight:700'>Por favor seleccione el indicador y el año</div>"
        & "<div style='font-size:14px;margin-top:12px'>Falta: " & faltan & "</div></div>" & firma & "</div>"

VAR sinDatos =
    abre & titulo & "<div style='height:500px;background:" & cClaro
        & ";text-align:center;padding:220px 40px 0 40px;box-sizing:border-box;font-size:18px;font-weight:600'>"
        & "No hay datos para esta selección</div>" & firma & "</div>"

RETURN
    SWITCH (
        TRUE (),
        NOT todoOk, aviso,
        ISBLANK ( n ) || n = 0, sinDatos,
        abre & titulo & svg & resumen & firma & "</div>"
    )