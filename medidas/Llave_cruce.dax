-- Columnas calculadas para relacionar TerriData con la tabla de homologación.
-- La relación va de TerriData[Llave_cruce] (varios) a la homologación[Llave_cruce] (uno).

-- En la tabla TerriData
Llave_cruce = TerriData[Indicador] & " | " & TerriData[Dimensión] & " | " & TerriData[Subcategoría] & " | " & TerriData[Fuente]

-- En la tabla Homologación_indicadores_fuente_homologada
Llave_cruce = 
'Homologación_indicadores_fuente_homologada'[Indicador] & " | " &
'Homologación_indicadores_fuente_homologada'[Dimensión] & " | " &
'Homologación_indicadores_fuente_homologada'[Subcategoría] & " | " &
'Homologación_indicadores_fuente_homologada'[Fuente]
