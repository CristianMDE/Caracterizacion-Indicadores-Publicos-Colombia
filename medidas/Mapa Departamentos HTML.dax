            { 95, "Guaviare", 1108, 1935, 1841, 2389, "M1433 2388l51-49 8-16 15 2 16-14 0-16 9 2-4-8 5-1 0 7 10 3-13-20 0-13 5-1 9-25-2-9 7-4 5-21 8-5 0-27 6 7 9-3 12 9 15-15 17-7 0-4 26-8 14-18 6 4 19-3 27 4 3-5 18-5 9 2 10-11 10 3 3-4 4 4 20-9 14 1 6-9 8-2-2-6 25-19-10-18-8 6-12-3 1 6-10-1-1 5-10-3 0-4-6 6-6-4-1 9-18-12-19 7-3-10-4 3-20-9-10-25-15-20-14 2-6-8-14 1-3-7 88-38-17-10-7 9-3-10-5-2 4 10-14 14-3-12-17 7 3-6-5-5-10 8 2-13-4-2-1 11-10-13 2 9-5 6-1-11-7 2-17-10-7 1-6-5-3 5-6-6-7 8-8-4-5 3-8-11-5 13-3-6-6 9-14-11-1 9-10-5-5 4-8-2 2 5-15 5-5-2 3-8-9 6-11-12-4 17-2-11-6-2-6 2 6 0-2 6-25 2-5 6-5-6-15 1-11-13-2 5-12 1 2 18-13-11-4 10-8-5-17 15-13-2 0 9-13-3-7 6 3 5-6 1-1 12-5-8-7 11-8-11-9 11-16-9-21 11-8 10 6 9-7-3 0 6-13 7-2-5-5 3-9 9-3-6 0 6-6 3-2-7-7 3-3-4-10 5 4 6-11 3-6-5-5 7-1-9-4 9-7-6-3 6-2-12-2 9-5-4-7 5-4-11-8 7-4-7-6 3-7 50-1 102 0 8 21 24 3 11 11 5 12 17 6 28 30 22 1 6 13 3-3 5 11 11 11 4 14-3 16-21 12-2 2-9-5-6 7-1-4-7 3-4 6 2 1-6 10 0-2 6 6 4 5-11 13 7 2-6 5 8 23 14 11-2 11 15 0 8 5 1-3 8 10-1 2 17 2-7 6 0 1 11-5 2 8 9 0-6 4 2 6 16 19-7 3 8 8 2-3 7z" },
            { 97, "Vaupés", 1433, 2104, 2016, 2765, "M1575 2498l7 3-1 5 14 3 9-8 9 18 6-4 2 7 12-1-4 5 5 3 6-8 6 1 15 20-10 9 12 11 1 14 11 17 13-7-4-4 9-5 12 13 10-6 9 14 12-7 13 16 0 12 11-7 4 7 9 1 3-6-9-3 15-9 16 6 1 6-8 0-16 19 3 5 3-7 6 5 3 31-8 3-1 9 15 18-17 16 10 11 12-7-7 12 10 6 2 8 9-1 9-15-2-5-9 1 2-8 8-6 10 7 4-9 3 8 11-6 8 5-10 5-1 20 16-3 9-10 15 13 5-3-8-9 15 3 10 14-6 0 4 21 5-11 8-5 6 10 17 3 3-7-5-5 6-3-1-11 6-2 3-5-5-4 5-5-8-1-2-7-12-7 1-10-20-26 13-22-9-8-1-19-44-25-2-7-16-3-20-24 2-9-6-10 0-135 7 5 1-7 13 4 4-7 22 4 27-20 13 11 2-8 26-16 22 24 12-7 0 9 19 0 3-10 13 4-14-21 8-6-3-15 6-6-11-8 5-5-11-7 4-5-9-11-9 0-6-7-11 0-8 10-5-7-24 1-9-6-19 5-1-9-14 4-6 7-7-3 0-128-42-11-25-19 13-27 0-15-8 2-6 9-14-1-20 9-4-4-3 4-10-3-10 11-9-2-18 5-3 5-27-4-19 3-6-4-14 18-26 8 0 4-17 7-15 15-12-9-9 3-6-7 0 27-8 5-5 21-7 4 2 9-9 25-5 1 0 13 13 20-10-3 0-7-5 1 4 8-9-2 0 16-16 14-15-2-8 16-51 49 11 6-6 7 4 7 8 4 2-6 5 11-3 6 6 3-4 5 7-5 12 13-6 11 6 3 5-3-3-4 10 0-5 8 7 0 3 9 7-6-4 8 6 8 14 4-2 6 15-6-6 10 12 0-1 9 8-2 4-11 5 9 9-2 1-7 7 8 6-2z" },
            { 99, "Vichada", 1625, 1255, 2358, 1973, "M1625 1944l17 10 7-2 1 11 5-6-2-9 10 13 1-11 4 2-2 13 10-8 5 5-3 6 17-7 3 12 14-14-4-10 5 2 3 10 7-9 17 10 1-5 28-8 1-12 14-4-5-20 10-1-13-9 8-2-2-6 9-11 7 2-1-7 5 7 5-2-2-11 5 9 4-2-6-16 10-2-13-12 9-4 1-6 9 3 11-7 5 10 12-6-4-12 12 7 5-2 3-8-6-13 14 13-3-16 6 10 5-12 13 3-4-8 7 10 7-9 7 3 4-5 4 5 4-20-4-3 17 1 3 6 7-12 7 9 6-4 4 4 13-10 2 14 5-7-2-9 6 1 3 9 5-6 2 7 6-1-3 8 13-8 4 7 4-3 4 3 13-10 10 2 2-12 3 11 11-4 6 7-4-13 12 3 8-12 21 4-4-10 8 7 11-3 5 5-4-11 12 8 0-10 6-4 8 2-1-9 10 7-9-13 19-2 0-14 28 8 0-8 14-1 0 11 11-7 0 9 9-15 2 7 18 3 4 10 41-27-18-38-1-18 9-5-3-14-5-13-11-8 7-36-4-48 7-22-10-16 6-12-5-22 45-34 5-14-8-26 9-31 37-33-17-27 7-13-17-14-43-5-10-7-43 26-23-7-33 13-29-5-18 8-10-3-11 7-30-3-7-7-10 3-27-6-6-5-16 6-23 22-14-2-6-10-18 6-22 13-51-3-8 4-5 13-54 71-31 12-14-6-44 32-22 9-1 19-31 26-19 6-13 32-14 9z" }
        }
    )

-- ===== Filtros obligatorios (indicador por llave de homologación y año) =====
VAR okInd = ISFILTERED ( 'Homologación_indicadores_fuente_homologada'[Llave] ) && HASONEVALUE ( 'Homologación_indicadores_fuente_homologada'[Llave] )
VAR okAno = ISFILTERED ( TerriData[Año] ) && HASONEVALUE ( TerriData[Año] )
VAR todoOk = okInd && okAno
VAR faltan0 =
    IF ( NOT okInd, "Indicador, " )
        & IF ( NOT okAno, "Año, " )
VAR faltan = IF ( LEN ( faltan0 ) > 2, LEFT ( faltan0, LEN ( faltan0 ) - 2 ) )

-- ===== Textos del título =====
VAR tDim = SELECTEDVALUE ( 'Homologación_indicadores_fuente_homologada'[Dimensión] )
VAR tSub = SELECTEDVALUE ( 'Homologación_indicadores_fuente_homologada'[Subcategoría] )
VAR tInd = SELECTEDVALUE ( 'Homologación_indicadores_fuente_homologada'[Indicador] )
VAR tFue = SELECTEDVALUE ( TerriData[Fuente] )
VAR tAno = SELECTEDVALUE ( TerriData[Año] )
VAR tUni = SELECTEDVALUE ( TerriData[Unidad de Medida] )
VAR hayFiltro6 =
    ISFILTERED ( TerriData[Departamento] ) || ISFILTERED ( TerriData[Código Departamento] )
        || ISFILTERED ( TerriData[Entidad] ) || ISFILTERED ( TerriData[Código Entidad] )

-- ===== Departamentos seleccionados (sin importar el indicador) =====
VAR depVis =
    CALCULATETABLE (
        SELECTCOLUMNS (
            VALUES ( TerriData[Código Departamento] ),
            "@d", IFERROR ( VALUE ( TerriData[Código Departamento] ), BLANK () )
        ),
        ALLEXCEPT (
            TerriData,
            TerriData[Departamento],
            TerriData[Código Departamento],
            TerriData[Entidad],
            TerriData[Código Entidad]
        )
    )

-- ===== Valor del indicador por departamento =====
-- Toma la fila del departamento (código XX000) y, para Bogotá, la de 11001.
VAR datos0 =
    ADDCOLUMNS (
        VALUES ( TerriData[Código Entidad] ),
        "@c", IFERROR ( VALUE ( TerriData[Código Entidad] ), BLANK () ),
        "@v", CALCULATE ( AVERAGE ( TerriData[Dato Winsorizado] ) )
    )
VAR datos =
    ADDCOLUMNS (
        FILTER ( datos0, [@c] = 11001 || ( [@c] >= 5000 && MOD ( [@c], 1000 ) = 0 ) ),
        "@d", IF ( [@c] = 11001, 11, INT ( [@c] / 1000 ) )
    )

VAR formasVis =
    ADDCOLUMNS (
        FILTER ( FormasDep, NOT hayFiltro6 || [cod] IN depVis ),
        "@v", MAXX ( FILTER ( datos, [@d] = [cod] ), [@v] )
    )

-- ===== Cuartiles (sobre los departamentos dibujados con dato distinto de cero) =====
VAR conDato = FILTER ( formasVis, NOT ISBLANK ( [@v] ) )
VAR nDato = COUNTROWS ( conDato )
VAR nSin = COUNTROWS ( formasVis ) - nDato
VAR sinCero = FILTER ( conDato, [@v] <> 0 )
VAR nSinCero = COUNTROWS ( sinCero )
VAR nCero = nDato - nSinCero
VAR vMin = MINX ( sinCero, [@v] )
VAR vMax = MAXX ( sinCero, [@v] )
VAR q1 = PERCENTILEX.INC ( sinCero, [@v], 0.25 )
VAR q2 = PERCENTILEX.INC ( sinCero, [@v], 0.50 )
VAR q3 = PERCENTILEX.INC ( sinCero, [@v], 0.75 )

VAR nSel = COUNTROWS ( formasVis )
VAR tDep =
    IF (
        hayFiltro6,
        IF (
            nSel <= 4,
            CONCATENATEX ( formasVis, [nom], ", ", [nom], ASC ),
            nSel & " departamentos seleccionados"
        ),
        "Todos los departamentos"
    )

-- ===== Encuadre =====
VAR x0 = MINX ( formasVis, [xmin] )
VAR y0 = MINX ( formasVis, [ymin] )
VAR x1 = MAXX ( formasVis, [xmax] )
VAR y1 = MAXX ( formasVis, [ymax] )
VAR lado = MAX ( x1 - x0, y1 - y0 )
VAR pad = ROUND ( lado * 0.02, 0 )
VAR grosor = MAX ( 1, ROUND ( lado / 1400, 0 ) )
VAR caja = ( x0 - pad ) & " " & ( y0 - pad ) & " " & ( x1 - x0 + 2 * pad ) & " " & ( y1 - y0 + 2 * pad )

-- ===== Formas coloreadas =====
VAR trazos =
    CONCATENATEX (
        formasVis,
        VAR v = [@v]
        VAR col =
            SWITCH (
                TRUE (),
                ISBLANK ( v ), cSinDato,
                v = 0, cCero,
                v <= q1, cQ1,
                v <= q2, cQ2,
                v <= q3, cQ3,
                cQ4
            )
        RETURN
            "<path d='" & [path] & "' fill='" & col & "'><title>" & [nom] & ": "
                & IF ( ISBLANK ( v ), "Sin dato", FORMAT ( v, fmt ) ) & "</title></path>",
        ""
    )

VAR svg =
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='" & caja
        & "' preserveAspectRatio='xMidYMid meet' style='width:100%;height:" & altoMapa
        & "px;display:block'><g stroke='" & cFondo & "' stroke-width='" & grosor
        & "' stroke-linejoin='round'>" & trazos & "</g></svg>"

-- ===== Leyenda con intervalos =====
VAR chipIni = "<span style='display:inline-block;margin:0 10px 4px 0;white-space:nowrap'><span style='display:inline-block;width:14px;height:14px;vertical-align:middle;margin-right:5px;background:"
VAR leyenda =
    "<div style='font-size:12px;text-align:center;padding:6px 4px;background:" & cFondo & "'>"
        & IF (
            nSinCero > 0,
            chipIni & cQ1 & "'></span>Q1: " & FORMAT ( vMin, fmt ) & " a " & FORMAT ( q1, fmt ) & "</span>"
                & chipIni & cQ2 & "'></span>Q2: &gt;" & FORMAT ( q1, fmt ) & " a " & FORMAT ( q2, fmt ) & "</span>"
                & chipIni & cQ3 & "'></span>Q3: &gt;" & FORMAT ( q2, fmt ) & " a " & FORMAT ( q3, fmt ) & "</span>"
                & chipIni & cQ4 & "'></span>Q4: &gt;" & FORMAT ( q3, fmt ) & " a " & FORMAT ( vMax, fmt ) & "</span>"
        )
        & chipIni & cSinDato & "'></span>Cero o sin dato</span>"
        & "<div style='font-size:11px;margin-top:2px'>" & nDato & " departamentos con dato"
        & IF ( nCero > 0, " (" & nCero & " en cero)" ) & " · " & nSin & " sin dato"
        & IF ( NOT ISBLANK ( tUni ), " · Unidad: " & tUni ) & "</div></div>"

-- ===== Título =====
VAR titulo =
    "<div style='border-left:6px solid " & cAcento & ";padding:2px 0 2px 10px;margin-bottom:4px'>"
        & "<div style='font-size:20px;font-weight:700;line-height:1.2'>" & tInd & " · " & tAno & "</div>"
        & "<div style='font-size:13px;margin-top:3px'>"
        & IF ( NOT ISBLANK ( tDim ) && NOT ISBLANK ( tSub ), tDim & " › " & tSub & " · " ) & "Fuente: " & tFue & "</div>"
        & "<div style='font-size:13px;font-weight:600'>" & tDep & "</div></div>"

VAR abre =
    "<div style='font-family:Segoe UI,Arial,sans-serif;color:" & cTexto & ";background:" & cFondo
        & ";width:100%;box-sizing:border-box;padding:6px 10px'>"

VAR aviso =
    abre & "<div style='height:" & altoMapa & "px;background:" & cClaro
        & ";text-align:center;padding:230px 40px 0 40px;box-sizing:border-box'>"
        & "<div style='font-size:22px;font-weight:700'>Por favor seleccione el indicador y el año</div>"
        & "<div style='font-size:14px;margin-top:12px'>Falta: " & faltan & "</div></div>" & firma & "</div>"

VAR sinDatos =
    abre & titulo & "<div style='height:" & altoMapa & "px;background:" & cClaro
        & ";text-align:center;padding:260px 40px 0 40px;box-sizing:border-box;font-size:18px;font-weight:600'>"
        & "No hay datos departamentales para esta selección</div>" & firma & "</div>"

RETURN
    SWITCH (
        TRUE (),
        NOT todoOk, aviso,
        ISBLANK ( nDato ) || nDato = 0, sinDatos,
        abre & titulo & svg & leyenda & firma & "</div>"
    )
